# Copy to .env and generate a fresh unpredictable 64-hex-character secret.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
PARCELTRACK_INTERNAL_KEY=
PARCELTRACK_API_URL=http://127.0.0.1:5000
PARCELTRACK_ENV=development
# Optional. Defaults to instance/parceltrack.sqlite3 and instance/uploads.
# PARCELTRACK_DB_PATH=/absolute/path/parceltrack.sqlite3
# PARCELTRACK_UPLOAD_DIR=/absolute/path/private-uploads
